{
  "mediaExtensions": [
    ".mp4",
    ".avi",
    ".mkv",
    ".mov",
    ".wmv",
    ".flv",
    ".webm",
    ".m4v",
    ".3gp",
    ".3g2",
    ".asf",
    ".divx",
    ".f4v",
    ".m2ts",
    ".m2v",
    ".mts",
    ".ogv",
    ".rm",
    ".rmvb",
    ".ts",
    ".vob",
    ".xvid"
  ],
  "tmdb": {
    "posterSize": "w500",
    "apiKey": "",
    "retryCount": 3,
    "language": "zh-CN",
    "proxyHost": "",
    "timeout": 30,
    "chinaApiUrl": "https://api.tmdb.org",
    "proxyPort": "",
    "baseUrl": "https://api.themoviedb.org",
    "chinaImageUrl": "https://image.tmdb.org",
    "imageBaseUrl": "https://image.tmdb.org",
    "backdropSize": "w1280",
    "region": "CN"
  },
  "scraping": {
    "useExistingScrapingInfo": false,
    "nfoFormat": "kodi",
    "enabled": true,
    "keepSubtitleFiles": false
  },
  "log": {
    "retentionDays": 7,
    "level": "info",
    "reportUsageData": true
  },
  "ai": {
    "baseUrl": "https://api.openai.com/v1",
    "qpmLimit": 60,
    "apiKey": "",
    "model": "gpt-3.5-turbo",
    "enabled": false
  },
  "notifications": {
    "includeFullPath": true,
    "maxDetailItems": 5,
    "configKey": "ostrm",
    "notifyOnFailure": true,
    "serverUrl": "http://apprise:8000",
    "notifyOnPartialSuccess": true,
    "notifyOnSuccess": true,
    "enabled": false,
    "tags": "all"
  },
  "scrapingRegex": {
    "movieRegexps": [
      "^(?<title>.+?)[. _]((?<year>19\\d{2}|20\\d{2}))",
      "^(?<title>.+?)[. _]\\[(?<year>19\\d{2}|20\\d{2})\\]",
      "^(?<title>.+?)[. _]\\((?<year>19\\d{2}|20\\d{2})\\)",
      "^(?<title>[\\u4e00-\\u9fff]+.*?)[. _](?:19|20)\\d{2}",
      "^(?<title>.+?)[. _](19|20)\\d{2}[. _](?<title2>.*)$",
      "^(?<title>[^.]+)[. ]+(?:19|20)\\d{2}",
      "^(?<title>.+?)[. _](?:19|20)\\d{2}$",
      "^(?<title>.+?)[. _](?:1080p|720p|480p|2160p|4K|BluRay|DVD|HDTV|BDRip|x264|x265)",
      "^(?<title>[\\u4e00-\\u9fff]+.+?)(?:\\.(?:mp4|mkv|avi|rmvb))?$",
      "^\\[(?<title>.+?)\\][. _](?:19|20)\\d{2}",
      "^(?<title>.+?)[. _]\\[(.+?)\\](?:[. _](?:19|20)\\d{2})?$"
    ],
    "tvDirRegexps": [
      "^(?<title>.+?)[. _]Season[. _](?<season>\\d{1,2})",
      "^(?<title>.+?)[. _]S(?<season>\\d{1,2})",
      "^(?<title>.+)[. _](?<year>19\\d{2}|20\\d{2})",
      "^(?<title>[\\u4e00-\\u9fff]+.*?)[. _]第[一二三四五六七八九十]+季",
      "^(?<title>.+?)[. _]Season[. _](?<season>\\d{1,2})[. _](?:Part|Disc)?\\d?",
      "^(?<title>.+?)[. _](?:19|20)\\d{2}[. _]Season[. _](?<season>\\d{1,2})",
      "^(?<title>.+?)[. _]S(?<season>\\d{1,2})(?:EP|EPISODE)?\\d?",
      "^(?<title>.+?)[. _](?:S|Season)[. _](?<season>\\d{1,2})(?:EP|EPISODE)?\\d?",
      "^(?<title>.+?)[. _]Season[. _](?<season>\\d{1,2})(?:Episode)?[. _](?:\\d{1,3})?"
    ],
    "tvFileRegexps": [
      "[._ ]S(?<season>\\d{1,2})E(?<episode>\\d{1,3})",
      "[._ ](?<season>\\d{1,2})x(?<episode>\\d{1,3})",
      "[._ ]Episode[._ ](?<episode>\\d{1,3})",
      "[._ ]第[一二三四五六七八九十]+集",
      "[._ ]EP(?<episode>\\d{1,3})",
      "[._ ]第[一二三四五六七八九十]+集[._ ](?<episode>\\d{1,2})",
      "[._ ]S(?<season>\\d{1,2})[._ ]EP?(?<episode>\\d{1,3})",
      "[._ ]第[一二三四五六七八九十]+季[._ ]第[一二三四五六七八九十]+集",
      "[._ ]Season[._ ](?<season>\\d{1,2})[._ ]Episode[._ ](?<episode>\\d{1,3})",
      "[._ ]Disc[._ ](?<disc>\\d{1,2})[._ ](?<episode>\\d{1,3})",
      "[._ ]S(?<season>\\d{1,2})-(?<episode>\\d{1,3})",
      "[._ ]S(?<season>\\d{1,2})\\.(?<episode>\\d{1,3})"
    ]
  }
}